    "Wendler's 5/3/1 with Boring But Big accessory volume. One main lift per day, then 5x10 BBB at 50–70% of training max.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wendlers 5/3/1 mit Boring-But-Big-Hilfsvolumen. Eine Hauptübung pro Tag, dann 5×10 BBB bei 50–70 % des Trainingsmaximums."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "5/3/1 de Wendler con volumen accesorio Boring But Big. Un levantamiento principal por día, luego 5x10 BBB al 50–70 % del máximo de entrenamiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "5/3/1 de Wendler avec volume accessoire Boring But Big. Un mouvement principal par jour, puis 5x10 BBB à 50–70 % du max d'entraînement."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "5/3/1 do Wendler com volume acessório Boring But Big. Um exercício principal por dia, depois 5x10 BBB a 50–70 % do máximo de treino."
          }
        }
      }
    },
