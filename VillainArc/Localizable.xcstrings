    "Keeps deleted completed workouts hidden instead of permanently removing the performance snapshots used for suggestion learning." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hält gelöschte abgeschlossene Workouts verborgen, statt die für das Vorschlagslernen genutzten Leistungs-Snapshots dauerhaft zu entfernen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keeps deleted completed workouts hidden instead of permanently removing the performance snapshots used for suggestion learning."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene ocultos los entrenamientos completados eliminados en lugar de borrar permanentemente las instantáneas de rendimiento usadas para el aprendizaje de sugerencias."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garde masquées les séances terminées supprimées au lieu de retirer définitivement les instantanés de performance utilisés pour l'apprentissage des suggestions."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene nascosti gli allenamenti completati eliminati invece di rimuovere definitivamente i dati di performance usati per imparare i suggerimenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "削除した完了済みワークアウトを、提案の学習に使うパフォーマンス記録を完全に削除せずに非表示のままにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "삭제한 운동을 완전히 지우지 않고 숨김 처리해, 제안 학습에 쓰이는 수행 기록을 남겨둡니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantém ocultos os treinos concluídos excluídos em vez de remover permanentemente os instantâneos de desempenho usados no aprendizado de sugestões."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалённые завершённые тренировки просто скрываются, а не стираются вместе с данными результатов, на которых учатся рекомендации."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将删除的已完成训练隐藏起来，而不是永久移除用于建议学习的表现快照。"
          }
        }
      }
    },
