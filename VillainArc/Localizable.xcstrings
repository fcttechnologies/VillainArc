          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以大重量练胸为主。体力充沛时先做推举，再做辅助动作。"
          }
        }
      }
    },
    "Heavy compound, then incline emphasis, then isolation pump." : {
      "localizations" : {
