            "value": "Drücken mit Schulterbetonung. Schulterdrücken führt, Brust-Hilfsübungen folgen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empuje con énfasis en hombros. El press militar lidera, los accesorios de pecho siguen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Poussée axée sur les épaules. Le développé militaire ouvre, les accessoires pectoraux suivent."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Empurrar com ênfase em ombros. O desenvolvimento lidera, os acessórios de peito seguem."
          }
        }
      }
    },
