    "Fast set-level logging with auto-fill from your plan. Rest timer, exercise notes, and previous session reference built in." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schnelle Protokollierung auf Satzebene mit automatischem Ausfüllen aus deinem Plan. Pausentimer, Übungsnotizen und Referenz zur vorherigen Einheit sind integriert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registro rápido a nivel de serie con autorrelleno desde tu plan. Temporizador de descanso, notas de ejercicio y referencia de la sesión anterior integrados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrement rapide au niveau de la série avec remplissage automatique depuis votre plan. Minuteur de repos, notes d'exercice et référence de la séance précédente intégrés."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registro rápido por série com preenchimento automático do seu plano. Cronômetro de descanso, notas de exercício e referência da sessão anterior integrados."
          }
        }
      }
    },
    "Favorite" : {
      "localizations" : {
        "de" : {
