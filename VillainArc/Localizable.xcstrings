      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere Benachrichtigungen in den Systemeinstellungen, um dies zu ändern. Villain Arc kann weiterhin In-App-Hinweise anzeigen, während du die App nutzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enable notifications in system settings to change this. Villain Arc can still show in-app toasts while you’re using the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa las notificaciones en los ajustes del sistema para cambiar esto. Villain Arc puede seguir mostrando avisos dentro de la app mientras la usas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez les notifications dans les réglages système pour modifier ceci. Villain Arc peut toujours afficher des notifications dans l'app pendant que vous l'utilisez."
