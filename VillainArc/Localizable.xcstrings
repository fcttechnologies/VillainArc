    "Send diagnostics, report issues, or request features. Diagnostics are stored on your device until you tap Send.": {
      "comment": "A footer for the app settings form.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sende Diagnosedaten, melde Probleme oder schlage Funktionen vor. Diagnosedaten werden auf deinem Gerät gespeichert, bis du auf „Senden“ tippst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía diagnósticos, informa de problemas o solicita funciones. Los diagnósticos se almacenan en tu dispositivo hasta que tocas Enviar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyez des diagnostics, signalez des problèmes ou proposez des fonctionnalités. Les diagnostics sont stockés sur votre appareil jusqu'à ce que vous touchiez Envoyer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envie diagnósticos, relate problemas ou solicite recursos. Os diagnósticos ficam armazenados no seu dispositivo até você tocar em Enviar."
          }
        }
      }
    },
