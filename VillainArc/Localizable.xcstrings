    "Main: 5/3/1 deadlift. BBB: 5x10 deadlift at 50–60% (these get heavy fast — start light). Light upper accessory." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hauptübung: 5/3/1 Kreuzheben. BBB: 5×10 Kreuzheben bei 50–60 % (wird schnell schwer — fang leicht an). Leichte Oberkörper-Hilfsübung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Principal: peso muerto 5/3/1. BBB: 5x10 de peso muerto al 50–60 % (se ponen pesadas rápido: empieza ligero). Accesorio ligero de tren superior."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Principal : soulevé de terre 5/3/1. BBB : 5x10 de soulevé de terre à 50–60 % (ça devient vite lourd — commencez léger). Accessoire léger pour le haut du corps."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Principale: 5/3/1 stacco. BBB: 5x10 stacco al 50–60% (diventano pesanti in fretta, parti leggero). Complementari leggeri per la parte alta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メイン：5/3/1のデッドリフト。BBB：トレーニングマックスの50〜60%で5x10のデッドリフト（すぐに重くなるので軽めから）。上半身の補助種目は軽めに。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메인: 5/3/1 데드리프트. BBB: 50–60%로 데드리프트 5x10 (금방 무거워지니 가볍게 시작하세요). 가벼운 상체 보조 운동."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Principal: levantamento terra 5/3/1. BBB: 5x10 de levantamento terra a 50–60 % (ficam pesados rápido — comece leve). Acessório leve de parte superior."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Основное: 5/3/1 становая. BBB: 5x10 становой на 50–60% (быстро становится тяжело — начните легко). Лёгкая подсобка на верх."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主项：5/3/1 硬拉。BBB：50–60% 强度硬拉 5x10（会很快变重 — 从轻的开始）。轻量上肢辅助。"
          }
        }
      }
    },
    "Main: 5/3/1 overhead press. BBB: 5x10 press at 50–70%. Pull-up volume to balance." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hauptübung: 5/3/1 Schulterdrücken. BBB: 5×10 Drücken bei 50–70 %. Klimmzug-Volumen zum Ausgleich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Principal: press militar 5/3/1. BBB: 5x10 de press al 50–70 %. Volumen de dominadas para equilibrar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Principal : développé militaire 5/3/1. BBB : 5x10 de développé à 50–70 %. Volume de tractions pour équilibrer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Principale: 5/3/1 lento avanti. BBB: 5x10 lento al 50–70%. Volume di trazioni per bilanciare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メイン：5/3/1のオーバーヘッドプレス。BBB：50〜70%で5x10のプレス。バランスを取るために懸垂のボリュームを追加。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메인: 5/3/1 오버헤드 프레스. BBB: 50–70%로 프레스 5x10. 균형을 위해 풀업으로 볼륨을 채워요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Principal: desenvolvimento 5/3/1. BBB: 5x10 de desenvolvimento a 50–70 %. Volume de barra fixa para equilibrar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Основное: 5/3/1 жим стоя. BBB: 5x10 жима на 50–70%. Подтягивания для баланса."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主项：5/3/1 过头推举。BBB：50–70% 强度推举 5x10。用引体向上的训练量来平衡。"
          }
        }
      }
    },
    "Main: 5/3/1 percentages on bench. BBB: 5x10 bench at 50–70% of training max. Finish with light back work." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hauptübung: 5/3/1-Prozentsätze beim Bankdrücken. BBB: 5×10 Bankdrücken bei 50–70 % des Trainingsmaximums. Abschluss mit leichter Rückenarbeit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Principal: porcentajes 5/3/1 en press de banca. BBB: 5x10 de banca al 50–70 % del máximo de entrenamiento. Termina con trabajo ligero de espalda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Principal : pourcentages 5/3/1 au développé couché. BBB : 5x10 de développé couché à 50–70 % du max d'entraînement. Terminez par un travail léger du dos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Principale: percentuali 5/3/1 sulla panca. BBB: 5x10 panca al 50–70% del massimale di allenamento. Chiudi con lavoro leggero per la schiena."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メイン：ベンチプレスの5/3/1のパーセンテージ。BBB：トレーニングマックスの50〜70%で5x10のベンチプレス。最後に軽い背中の種目。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메인: 벤치 5/3/1 퍼센트. BBB: 트레이닝 맥스의 50–70%로 벤치 5x10. 가벼운 등 운동으로 마무리해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Principal: percentuais 5/3/1 no supino. BBB: 5x10 de supino a 50–70 % do máximo de treino. Finalize com trabalho leve de costas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Основное: 5/3/1 проценты в жиме лёжа. BBB: 5x10 жима на 50–70% от тренировочного максимума. В конце лёгкая работа на спину."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主项：按 5/3/1 百分比做卧推。BBB：训练最大值 50–70% 强度卧推 5x10。最后做轻量背部训练。"
          }
        }
      }
    },
    "Main: 5/3/1 squat. BBB: 5x10 squat at 50–70%. Finish with hamstring and ab accessory." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hauptübung: 5/3/1 Kniebeuge. BBB: 5×10 Kniebeugen bei 50–70 %. Abschluss mit Beinbeuger- und Bauch-Hilfsübung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Principal: sentadilla 5/3/1. BBB: 5x10 de sentadilla al 50–70 %. Termina con accesorio de isquiotibiales y abdomen."
          }
        },
        "fr" : {
          "stringUnit" : {
