    "Posterior-chain emphasis. RDL leads, hamstrings and glutes prioritized." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betonung der hinteren Kette. RDL führt, Beinbeuger und Gesäß haben Priorität."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Énfasis en la cadena posterior. El peso muerto rumano lidera, con prioridad en isquiotibiales y glúteos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accent sur la chaîne postérieure. Le soulevé de terre roumain ouvre, ischio-jambiers et fessiers prioritaires."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enfasi sulla catena posteriore. Si apre con lo stacco rumeno, priorità a femorali e glutei."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "後面の筋群を重視。RDLを軸に、ハムストリングと臀筋を優先。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "후면 사슬 위주. RDL로 시작해 햄스트링과 둔근을 우선해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ênfase na cadeia posterior. O stiff lidera, com prioridade em posteriores e glúteos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Акцент на заднюю цепь. Во главе румынская тяга, приоритет — бицепс бедра и ягодицы."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "侧重后链。以罗马尼亚硬拉领衔，优先练腘绳肌和臀肌。"
          }
        }
      }
    },
    "Posterior-chain focus with isolation accessories." : {
      "comment" : "Name of a workout day.",
