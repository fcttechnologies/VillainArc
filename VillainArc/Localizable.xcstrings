    "Main: 5/3/1 deadlift. BBB: 5x10 deadlift at 50–60% (these get heavy fast — start light). Light upper accessory." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hauptübung: 5/3/1 Kreuzheben. BBB: 5×10 Kreuzheben bei 50–60 % (wird schnell schwer — fang leicht an). Leichte Oberkörper-Hilfsübung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Principal: peso muerto 5/3/1. BBB: 5x10 de peso muerto al 50–60 % (se ponen pesadas rápido: empieza ligero). Accesorio ligero de tren superior."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Principal : soulevé de terre 5/3/1. BBB : 5x10 de soulevé de terre à 50–60 % (ça devient vite lourd — commencez léger). Accessoire léger pour le haut du corps."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Principal: levantamento terra 5/3/1. BBB: 5x10 de levantamento terra a 50–60 % (ficam pesados rápido — comece leve). Acessório leve de parte superior."
          }
        }
      }
    },
    "Main: 5/3/1 overhead press. BBB: 5x10 press at 50–70%. Pull-up volume to balance." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hauptübung: 5/3/1 Schulterdrücken. BBB: 5×10 Drücken bei 50–70 %. Klimmzug-Volumen zum Ausgleich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Principal: press militar 5/3/1. BBB: 5x10 de press al 50–70 %. Volumen de dominadas para equilibrar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Principal : développé militaire 5/3/1. BBB : 5x10 de développé à 50–70 %. Volume de tractions pour équilibrer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Principal: desenvolvimento 5/3/1. BBB: 5x10 de desenvolvimento a 50–70 %. Volume de barra fixa para equilibrar."
          }
        }
      }
    },
    "Main: 5/3/1 percentages on bench. BBB: 5x10 bench at 50–70% of training max. Finish with light back work." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hauptübung: 5/3/1-Prozentsätze beim Bankdrücken. BBB: 5×10 Bankdrücken bei 50–70 % des Trainingsmaximums. Abschluss mit leichter Rückenarbeit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Principal: porcentajes 5/3/1 en press de banca. BBB: 5x10 de banca al 50–70 % del máximo de entrenamiento. Termina con trabajo ligero de espalda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Principal : pourcentages 5/3/1 au développé couché. BBB : 5x10 de développé couché à 50–70 % du max d'entraînement. Terminez par un travail léger du dos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Principal: percentuais 5/3/1 no supino. BBB: 5x10 de supino a 50–70 % do máximo de treino. Finalize com trabalho leve de costas."
          }
        }
      }
    },
    "Main: 5/3/1 squat. BBB: 5x10 squat at 50–70%. Finish with hamstring and ab accessory." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hauptübung: 5/3/1 Kniebeuge. BBB: 5×10 Kniebeugen bei 50–70 %. Abschluss mit Beinbeuger- und Bauch-Hilfsübung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Principal: sentadilla 5/3/1. BBB: 5x10 de sentadilla al 50–70 %. Termina con accesorio de isquiotibiales y abdomen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Principal : squat 5/3/1. BBB : 5x10 de squat à 50–70 %. Terminez par un accessoire ischio-jambiers et abdominaux."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Principal: agachamento 5/3/1. BBB: 5x10 de agachamento a 50–70 %. Finalize com acessório de posteriores e abdômen."
          }
        }
      }
    },
