    "Deadlift opener sets the tone. Wide-to-narrow back work after.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Kreuzheben zu Beginn gibt den Ton an. Danach Rückenarbeit von breit nach eng."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El peso muerto inicial marca el ritmo. Después, trabajo de espalda de agarre amplio a estrecho."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le soulevé de terre d'ouverture donne le ton. Ensuite, travail du dos de large à serré."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O levantamento terra de abertura dá o tom. Depois, trabalho de costas do aberto ao fechado."
          }
        }
      }
    },
    "Deadlift-focused lower with posterior-chain accessories.": {
      "comment": "Name of the exercises performed in the \"Lower B\" day of the \"Upper / Lower\" 4-day split plan.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kreuzheben-fokussierter Unterkörper mit Zubehör für die hintere Kette."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tren inferior centrado en el peso muerto con accesorios para la cadena posterior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bas du corps axé sur le soulevé de terre avec des accessoires pour la chaîne postérieure."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inferior focado em levantamento terra com acessórios para a cadeia posterior."
          }
        }
      }
    },
    "Deadlift-led full body with vertical pressing.": {
      "localizations": {
