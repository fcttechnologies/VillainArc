            "value" : "Chiede lo sforzo post-allenamento prima del riepilogo, al salvataggio dell'allenamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ワークアウトの保存時、サマリーの前にワークアウト後の努力度をたずねます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "운동을 저장할 때 요약 화면 전에 운동 후 노력도를 묻습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pergunta o esforço pós-treino antes do resumo quando o treino está sendo salvo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запрашивает усилие после тренировки перед итогами, когда тренировка сохраняется."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存训练时，在总结之前询问训练后强度。"
          }
        }
