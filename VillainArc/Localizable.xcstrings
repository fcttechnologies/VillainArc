    "%@, you're burning about the same amount of energy a day as you did last year." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, du verbrennst pro Tag etwa gleich viel Energie wie im letzten Jahr."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, you're burning about the same amount of energy a day as you did last year."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, estás quemando aproximadamente la misma energía al día que el año pasado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, tu brûles environ la même quantité d'énergie par jour que l'an dernier."
