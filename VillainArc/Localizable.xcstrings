    "Background App Refresh is off, so Villain Arc can’t reliably deliver steps goal notifications while the app is closed.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Background App Refresh is off, so Villain Arc can’t reliably deliver steps goal notifications while the app is closed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hintergrundaktualisierung ist deaktiviert, daher kann Villain Arc Benachrichtigungen zum Schrittziel nicht zuverlässig zustellen, während die App geschlossen ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La actualización en segundo plano está desactivada, por lo que Villain Arc no puede entregar de forma fiable las notificaciones del objetivo de pasos mientras la app está cerrada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'actualisation en arrière-plan est désactivée, Villain Arc ne peut donc pas envoyer de façon fiable les notifications d'objectif de pas lorsque l'app est fermée."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A atualização em segundo plano está desativada, então o Villain Arc não consegue entregar de forma confiável as notificações de meta de passos enquanto o app está fechado."
          }
        }
      }
    },
