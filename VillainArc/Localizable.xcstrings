    "You have %lld of %lld rated sessions needed to surface correlations. Rate workouts on the summary screen — \"Great\", \"Good\", \"OK\", or \"Tough\" — to feed this view." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast %1$lld von %2$lld bewerteten Einheiten, die nötig sind, um Korrelationen anzuzeigen. Bewerte Workouts im Zusammenfassungsbildschirm — „Sehr gut“, „Gut“, „OK“ oder „Zäh“ —, um diese Ansicht zu speisen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You have %1$lld of %2$lld rated sessions needed to surface correlations. Rate workouts on the summary screen — \"Great\", \"Good\", \"OK\", or \"Tough\" — to feed this view."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tienes %1$lld de %2$lld sesiones valoradas necesarias para mostrar correlaciones. Valora los entrenamientos en la pantalla de resumen — «Excelente», «Bien», «OK» o «Exigente» — para alimentar esta vista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez %1$lld séances notées sur les %2$lld nécessaires pour faire apparaître des corrélations. Notez vos séances sur l'écran récapitulatif — « Excellent », « Bien », « OK » ou « Éprouvant » — pour alimenter cette vue."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você tem %1$lld de %2$lld sessões avaliadas necessárias para exibir correlações. Avalie os treinos na tela de resumo — “Ótimo”, “Bom”, “OK” ou “Puxado” — para alimentar esta visualização."
          }
        }
      }
    },
