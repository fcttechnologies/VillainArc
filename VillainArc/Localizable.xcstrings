    "One of these workout plans is currently being edited. Deleting them will close the editor and discard its editing copy." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einer dieser Trainingspläne wird gerade bearbeitet. Wenn du sie löschst, wird der Editor geschlossen und die Bearbeitungskopie verworfen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uno de estos planes de entrenamiento se está editando ahora mismo. Si los eliminas, se cerrará el editor y se descartará su copia de edición."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'un de ces programmes d'entraînement est en cours de modification. Si tu les supprimes, l'éditeur se fermera et sa copie de travail sera abandonnée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una di queste schede è in fase di modifica. Eliminandole, l'editor si chiuderà e la copia in modifica verrà scartata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらのワークアウトプランのいずれかを現在編集中です。削除すると編集画面が閉じ、編集中の内容は破棄されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 운동 플랜 중 하나를 편집하고 있어요. 삭제하면 편집기가 닫히고 편집 중이던 내용이 사라져요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um destes planos de treino está sendo editado no momento. Se você excluí-los, o editor será fechado e sua cópia de edição será descartada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Один из этих планов сейчас редактируется. Удаление закроет редактор и отбросит рабочую копию."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其中一个训练计划正在编辑中。删除后会关闭编辑器并放弃编辑副本。"
          }
        }
      }
    },
