    "Shoulder-emphasis push. Overhead press leads, chest accessories follow." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücken mit Schulterbetonung. Schulterdrücken führt, Brust-Hilfsübungen folgen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empuje con énfasis en hombros. El press militar lidera, los accesorios de pecho siguen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poussée axée sur les épaules. Le développé militaire ouvre, les accessoires pectoraux suivent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Push con enfasi sulle spalle. Si apre con il lento avanti, poi i complementari per il petto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "肩を重視したプッシュ。オーバーヘッドプレスを軸に、胸の補助種目を続けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어깨 위주 푸시. 오버헤드 프레스로 시작하고 가슴 보조 운동을 이어가요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empurrar com ênfase em ombros. O desenvolvimento lidera, os acessórios de peito seguem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жимовой день с акцентом на плечи. Во главе жим стоя, затем подсобка на грудь."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "侧重肩部的推日。以过头推举领衔，随后做胸部辅助动作。"
          }
        }
      }
    },
