    "Live Activities are not available on this device or are disabled in system settings. The app will fall back to in app toasts and local notifications when possible." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live Activities sind auf diesem Gerät nicht verfügbar oder in den Systemeinstellungen deaktiviert. Die App greift, wenn möglich, auf In-App-Hinweise und lokale Benachrichtigungen zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las Live Activities no están disponibles en este dispositivo o están desactivadas en los ajustes del sistema. La app recurrirá a avisos dentro de la app y notificaciones locales cuando sea posible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les activités en direct ne sont pas disponibles sur cet appareil ou sont désactivées dans les réglages système. L'app utilisera, si possible, des notifications dans l'app et locales."
