    "Villain Arc Pro unlocks AI features and advanced health insights. Cancel anytime in Settings." : {
      "comment" : "A footer text for the subscription section of the app settings.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Villain Arc Pro schaltet KI-Funktionen und erweiterte Gesundheits-Insights frei. Jederzeit in den Einstellungen kündbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Villain Arc Pro desbloquea las funciones de IA y la información de salud avanzada. Cancela cuando quieras en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Villain Arc Pro débloque les fonctionnalités IA et les analyses de santé avancées. Annulez à tout moment dans les Réglages."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Villain Arc Pro desbloqueia os recursos de IA e os insights de saúde avançados. Cancele quando quiser em Ajustes."
          }
        }
      }
    },
    "Villain Arc studies your logs and recommends load or rep adjustments to keep you progressing safely." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Villain Arc analysiert deine Protokolle und empfiehlt Last- oder Wiederholungsanpassungen, damit du sicher weiter Fortschritte machst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Villain Arc estudia tus registros y recomienda ajustes de carga o repeticiones para que sigas progresando de forma segura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Villain Arc étudie vos journaux et recommande des ajustements de charge ou de répétitions pour que vous continuiez à progresser en toute sécurité."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Villain Arc estuda seus registros e recomenda ajustes de carga ou repetições para você continuar progredindo com segurança."
          }
        }
      }
    },
    "Villain Arc uses your location to record GPS routes for outdoor runs, walks, and hikes. Your location is only used while a cardio session is active." : {
      "comment" : "A description of how location is used for outdoor runs.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Villain Arc nutzt deinen Standort, um GPS-Routen für Läufe, Spaziergänge und Wanderungen im Freien aufzuzeichnen. Dein Standort wird nur verwendet, während eine Cardio-Session aktiv ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Villain Arc usa tu ubicación para grabar rutas GPS de carreras, caminatas y senderismo al aire libre. Tu ubicación solo se usa mientras una sesión de cardio está activa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Villain Arc utilise votre localisation pour enregistrer des itinéraires GPS de courses, marches et randonnées en extérieur. Votre localisation n'est utilisée que pendant une séance de cardio active."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Villain Arc usa sua localização para gravar rotas GPS de corridas, caminhadas e trilhas ao ar livre. Sua localização só é usada enquanto uma sessão de cardio está ativa."
          }
        }
      }
    },
    "Villain Arc will save the cardio session and any Health metrics or route data captured so far." : {
      "comment" : "A confirmation dialog message for finishing a cardio session.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Villain Arc speichert die Cardio-Session und alle bisher erfassten Health-Metriken oder Routendaten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Villain Arc guardará la sesión de cardio y cualquier métrica de Salud o dato de ruta capturado hasta ahora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Villain Arc enregistrera la séance de cardio ainsi que toutes les statistiques Santé ou données d'itinéraire capturées jusqu'à présent."
          }
