    "Want to start a rest timer for %@ to reflect the new set rest time?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Möchtest du einen Pausentimer für %@ starten, der die neue Satzpausenzeit widerspiegelt?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Want to start a rest timer for %@ to reflect the new set rest time?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Quieres iniciar un temporizador de descanso para %@ que refleje el nuevo tiempo de descanso de la serie?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veux-tu démarrer un minuteur de repos pour %@ reflétant le nouveau temps de repos de la série ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuoi avviare un timer di recupero di %@ per riflettere il nuovo tempo di recupero della serie?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいセットの休憩時間に合わせて、%@の休憩タイマーを開始しますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 세트 휴식 시간에 맞춰 %@ 휴식 타이머를 시작할까요?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quer iniciar um cronômetro de descanso para %@ que reflita o novo tempo de descanso da série?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запустить таймер отдыха на %@ с новым временем отдыха?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要为%@启动休息计时器，以匹配新的组间休息时间吗？"
          }
        }
      }
    },
    "Want to update rest timer to reflect the new set rest time?" : {
      "localizations" : {
        "de" : {
