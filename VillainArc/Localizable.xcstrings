    "Saving will remove any unresolved suggestion state for this exercise, including pending, deferred, and still-being-evaluated suggestions.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving will remove any unresolved suggestion state for this exercise, including pending, deferred, and still-being-evaluated suggestions."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Speichern wird jeder ungelöste Vorschlagsstatus für diese Übung entfernt, einschließlich ausstehender, zurückgestellter und noch in Bewertung befindlicher Vorschläge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al guardar se eliminará cualquier estado de sugerencia sin resolver para este ejercicio, incluidas las sugerencias pendientes, aplazadas y aún en evaluación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'enregistrement supprimera tout état de suggestion non résolu pour cet exercice, y compris les suggestions en attente, reportées et encore en cours d'évaluation."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvar removerá qualquer estado de sugestão não resolvido para este exercício, incluindo sugestões pendentes, adiadas e ainda em avaliação."
          }
        }
      }
    },
