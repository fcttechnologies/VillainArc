    "On %@, you burned %@ total, including %@ active." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am %1$@ hast du insgesamt %2$@ verbrannt, davon %3$@ aktiv."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On %1$@, you burned %2$@ total, including %3$@ active."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El %1$@ quemaste %2$@ en total, incluidas %3$@ activas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le %1$@, tu as brûlé %2$@ au total, dont %3$@ actives."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il %1$@ hai bruciato %2$@ in totale, di cui %3$@ attivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@は合計%2$@を消費し、うちアクティブが%3$@でした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@에 총 %2$@를 소모했고, 그중 활동 에너지는 %3$@예요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em %1$@, você queimou %2$@ no total, incluindo %3$@ ativas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ у тебя сожжено %2$@ всего, из них %3$@ активных."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@，你总共消耗了%2$@，其中活动消耗%3$@。"
          }
        }
      }
    },
    "On %@, you covered %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
