    "Manage Apple Health permissions and choose whether removed Health data stays in this app." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwalte die Apple-Health-Berechtigungen und wähle, ob entfernte Health-Daten in dieser App bleiben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestiona los permisos de Apple Salud y elige si los datos de Salud eliminados permanecen en esta app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gérez les autorisations Apple Santé et choisissez si les données Santé supprimées restent dans cette app."
          }
