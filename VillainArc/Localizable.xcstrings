    "Location access is required to record your route and calculate distance." : {
      "comment" : "A description of the location access requirement for recording a cardio session.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standortzugriff ist erforderlich, um deine Route aufzuzeichnen und die Distanz zu berechnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se requiere acceso a la ubicación para grabar tu ruta y calcular la distancia."
