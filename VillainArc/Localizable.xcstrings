    "Choose how weight, height, distance, energy, and temperature are displayed throughout the app." : {
      "comment" : "A description of the units picker.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle, wie Gewicht, Größe, Distanz, Energie und Temperatur in der gesamten App angezeigt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige cómo se muestran el peso, la altura, la distancia, la energía y la temperatura en toda la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez comment le poids, la taille, la distance, l'énergie et la température s'affichent dans toute l'app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli come vengono mostrati peso, altezza, distanza, energia e temperatura in tutta l'app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "体重、身長、距離、エネルギー、温度をアプリ全体でどう表示するかを選びます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 전체에서 체중, 키, 거리, 에너지, 온도를 어떤 단위로 표시할지 선택하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha como peso, altura, distância, energia e temperatura são exibidos em todo o app."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите, как в приложении показываются вес, рост, дистанция, энергия и температура."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择重量、身高、距离、能量和温度在应用中的显示方式。"
          }
        }
      }
    },
    "Choose up to %lld metrics to show on the cardio Live Activity. Selecting a new one when two are already chosen replaces the oldest." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle bis zu %lld Metriken für die Cardio-Live-Aktivität. Wenn bereits zwei ausgewählt sind, ersetzt eine neue die älteste."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige hasta %lld métricas para mostrar en la actividad en vivo de cardio. Si ya hay dos seleccionadas, la nueva reemplaza a la más antigua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisis jusqu’à %lld métriques à afficher dans l’activité en direct de cardio. Si deux sont déjà sélectionnées, la nouvelle remplace la plus ancienne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli fino a %lld dati da mostrare nell'attività in tempo reale del cardio. Se ne selezioni uno nuovo quando ne hai già due, sostituisce il più vecchio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有酸素運動のLive Activityに表示する指標を最大%lld件まで選べます。すでに2件選択されている状態で新しく選ぶと、最も古いものが置き換わります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "유산소 실시간 활동에 표시할 지표를 최대 %lld개까지 선택하세요. 2개가 선택된 상태에서 새로 고르면 가장 오래된 항목이 교체돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha até %lld métricas para exibir na atividade ao vivo de cardio. Se duas já estiverem selecionadas, a nova substitui a mais antiga."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите до %lld показателей для Live Activity кардио. Если выбрать новый, когда уже есть два, заменится самый старый."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最多可选择%lld项指标显示在有氧实时活动上。已选两项时再选新的，会替换最早选择的那项。"
          }
        }
      }
    },
    "Choose whether the app follows your device appearance or always uses light or dark mode." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle, ob die App dem Erscheinungsbild deines Geräts folgt oder immer den hellen oder dunklen Modus verwendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige si la app sigue la apariencia de tu dispositivo o siempre usa el modo claro u oscuro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisis si l'app suit l'apparence de ton appareil ou utilise toujours le mode clair ou sombre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli se l'app segue l'aspetto del dispositivo o usa sempre la modalità chiara o scura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイスの外観設定に合わせるか、常にライトモードまたはダークモードを使うかを選びます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱이 기기 화면 모드를 따를지, 항상 라이트 또는 다크 모드를 쓸지 선택하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha se o app segue a aparência do seu dispositivo ou usa sempre o modo claro ou escuro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите, следовать оформлению устройства или всегда использовать светлую либо тёмную тему."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择应用是跟随设备外观，还是始终使用浅色或深色模式。"
          }
        }
      }
    },
    "Choose whether you receive a notification when you reach your hydration goal, or also receive coaching notifications for surpassing your goal." : {
      "comment" : "A description of the hydration notification mode picker.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle, ob du eine Benachrichtigung erhältst, wenn du dein Flüssigkeitsziel erreichst, oder auch Coaching-Benachrichtigungen, wenn du dein Ziel übertriffst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige si recibes una notificación al alcanzar tu objetivo de hidratación, o también notificaciones de coaching al superarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisis si tu reçois une notification lorsque tu atteins ton objectif d'hydratation, ou aussi des notifications de coaching lorsque tu le dépasses."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli se ricevere una notifica quando raggiungi l'obiettivo di idratazione o anche notifiche di incoraggiamento quando lo superi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "水分補給目標を達成したときに通知を受け取るか、目標を上回ったときのコーチング通知も受け取るかを選びます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수분 섭취 목표를 달성했을 때만 알림을 받을지, 목표를 넘겼을 때 코칭 알림도 받을지 선택하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha se você recebe uma notificação ao atingir sua meta de hidratação, ou também notificações de coaching ao superá-la."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите, получать уведомление только при достижении цели по воде или ещё и подсказки за её перевыполнение."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择只在达成饮水目标时收到通知，还是超出目标时也收到指导通知。"
          }
        }
      }
    },
    "Choose whether you receive notifications when you complete your sleep goal only, or also receive weekly coaching recaps for your sleep averages." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle, ob du nur Benachrichtigungen erhältst, wenn du dein Schlafziel erreichst, oder auch wöchentliche Coaching-Zusammenfassungen deiner Schlafdurchschnitte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige si recibes notificaciones solo cuando completas tu objetivo de sueño, o también resúmenes de coaching semanales de tus promedios de sueño."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisis si tu reçois des notifications uniquement lorsque tu atteins ton objectif de sommeil, ou aussi des récapitulatifs de coaching hebdomadaires de tes moyennes de sommeil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli se ricevere notifiche solo quando completi l'obiettivo di sonno o anche riepiloghi settimanali sulle tue medie di sonno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠目標を達成したときだけ通知を受け取るか、睡眠の平均に関する週間コーチングのまとめも受け取るかを選びます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수면 목표를 달성했을 때만 알림을 받을지, 주간 수면 평균 코칭 요약도 받을지 선택하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha se você recebe notificações apenas ao concluir sua meta de sono, ou também resumos de coaching semanais das suas médias de sono."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите, получать уведомления только при достижении цели по сну или ещё и еженедельные сводки по среднему сну."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择只在完成睡眠目标时收到通知，还是也收到每周睡眠均值的指导回顾。"
          }
        }
      }
    },
    "Choose whether you receive notifications when you complete your steps goal only, or also receive coaching notifications for double goal, triple goal, and new best milestones." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle, ob du nur Benachrichtigungen erhältst, wenn du dein Schrittziel erreichst, oder auch Coaching-Benachrichtigungen für doppeltes Ziel, dreifaches Ziel und neue Bestwerte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige si recibes notificaciones solo cuando completas tu objetivo de pasos, o también notificaciones de coaching por objetivo doble, objetivo triple y nuevos récords."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisis si tu reçois des notifications uniquement lorsque tu atteins ton objectif de pas, ou aussi des notifications de coaching pour l'objectif doublé, triplé et les nouveaux records."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli se ricevere notifiche solo quando completi l'obiettivo di passi o anche notifiche di incoraggiamento per doppio obiettivo, triplo obiettivo e nuovi record."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "歩数目標を達成したときだけ通知を受け取るか、目標の2倍・3倍達成や自己ベスト更新のコーチング通知も受け取るかを選びます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "걸음 수 목표를 달성했을 때만 알림을 받을지, 목표 2배·3배 달성과 최고 기록 갱신 코칭 알림도 받을지 선택하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha se você recebe notificações apenas ao concluir sua meta de passos, ou também notificações de coaching por meta dobrada, meta triplicada e novos recordes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите, получать уведомления только при достижении цели по шагам или ещё и подсказки за двойную, тройную цель и новые рекорды."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择只在完成步数目标时收到通知，还是在双倍目标、三倍目标和新纪录里程碑时也收到指导通知。"
          }
        }
      }
    },
    "Chooses whether previous values come from any workout or from the last completed session for the same plan." : {
      "comment" : "A hint for the workout settings previous reference source.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legt fest, ob vorherige Werte aus einem beliebigen Workout oder aus der letzten abgeschlossenen Einheit desselben Plans stammen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige si los valores anteriores provienen de cualquier entrenamiento o de la última sesión completada del mismo plan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Détermine si les valeurs précédentes proviennent de n'importe quelle séance ou de la dernière séance terminée du même plan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sceglie se i valori precedenti provengono da un allenamento qualsiasi o dall'ultima sessione completata con la stessa scheda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前回の値を、任意のワークアウトから取得するか、同じプランで最後に完了したセッションから取得するかを選びます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이전 값을 모든 운동에서 가져올지, 같은 플랜의 마지막 완료 세션에서 가져올지 선택합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolhe se os valores anteriores vêm de qualquer treino ou da última sessão concluída do mesmo plano."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Определяет, брать прошлые значения из любой тренировки или из последней завершённой по этому же плану."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择上次数值取自任意一次训练，还是同一计划最近完成的那次训练。"
          }
        }
      }
    },
    "Classic 5-day bodybuilding split. One muscle group per day with high volume." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klassischer 5-Tage-Bodybuilding-Split. Eine Muskelgruppe pro Tag mit hohem Volumen."
          }
