    "Keeps deleted completed workouts hidden instead of permanently removing the performance snapshots used for suggestion learning." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hält gelöschte abgeschlossene Workouts verborgen, statt die für das Vorschlagslernen genutzten Leistungs-Snapshots dauerhaft zu entfernen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keeps deleted completed workouts hidden instead of permanently removing the performance snapshots used for suggestion learning."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene ocultos los entrenamientos completados eliminados en lugar de borrar permanentemente las instantáneas de rendimiento usadas para el aprendizaje de sugerencias."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
