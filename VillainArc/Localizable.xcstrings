    "Leave this blank and save to go back to the system default. The default adapts to the exercise and working load." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass dies leer und speichere, um zur Systemvorgabe zurückzukehren. Die Vorgabe passt sich an Übung und Arbeitslast an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leave this blank and save to go back to the system default. The default adapts to the exercise and working load."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja esto en blanco y guarda para volver al valor predeterminado del sistema. El valor predeterminado se adapta al ejercicio y a la carga de trabajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez ce champ vide et enregistrez pour revenir à la valeur par défaut du système. Celle-ci s'adapte à l'exercice et à la charge de travail."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lascia vuoto e salva per tornare al valore predefinito. Il valore predefinito si adatta all'esercizio e al carico di lavoro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空欄のまま保存すると、システム標準に戻ります。標準値は種目と扱う重量に応じて調整されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비워둔 채 저장하면 기본값으로 돌아가요. 기본값은 종목과 사용 중량에 맞춰 조정돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe em branco e salve para voltar ao padrão do sistema. O padrão se adapta ao exercício e à carga de trabalho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оставьте поле пустым и сохраните, чтобы вернуть значение по умолчанию. Оно подстраивается под упражнение и рабочий вес."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "留空并保存即可恢复系统默认值。默认值会根据动作和训练负重自动调整。"
          }
        }
      }
    },
