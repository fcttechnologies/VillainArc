    "Turn off live activities completely or restart the current one if it was dismissed accidentally." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalte Live Activities komplett aus oder starte die aktuelle neu, falls sie versehentlich geschlossen wurde."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn off live activities completely or restart the current one if it was dismissed accidentally."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactiva las Live Activities por completo o reinicia la actual si se cerró por accidente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivez complètement les activités en direct ou redémarrez l'activité actuelle si elle a été fermée par accident."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattiva del tutto le attività in tempo reale o riavvia quella attuale se l'hai chiusa per sbaglio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live Activityを完全にオフにするか、誤って閉じてしまった場合に現在のものを再開できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실시간 활동을 완전히 끄거나, 실수로 닫았다면 다시 시작하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desative as Live Activities completamente ou reinicie a atual se ela foi dispensada por acidente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Полностью отключите Live Activities или перезапустите текущую, если закрыли её случайно."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完全关闭实时活动，或在不小心关掉后重新启动当前的实时活动。"
          }
        }
      }
    },
    "Turn this off to stop Villain Arc from generating suggestions for this exercise anywhere in the app." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalte dies aus, damit Villain Arc nirgends in der App Vorschläge für diese Übung generiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn this off to stop Villain Arc from generating suggestions for this exercise anywhere in the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactiva esto para que Villain Arc deje de generar sugerencias para este ejercicio en cualquier parte de la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
