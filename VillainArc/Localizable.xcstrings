    "Pull-up-led back day. Vertical pulling first, then horizontal volume." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klimmzug-geführter Rückentag. Zuerst vertikales Ziehen, dann horizontales Volumen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Día de espalda guiado por dominadas. Primero tirón vertical, luego volumen horizontal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Journée dos menée par les tractions. D'abord le tirage vertical, puis le volume horizontal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giorno schiena guidato dalle trazioni. Prima le trazioni verticali, poi volume orizzontale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "懸垂を軸にした背中の日。垂直方向の引く動作から始め、次に水平方向のボリュームを重ねます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "풀업으로 시작하는 등 데이. 수직 당기기를 먼저 하고 수평 당기기로 볼륨을 채워요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dia de costas guiado por barra fixa. Primeiro puxada vertical, depois volume horizontal."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "День спины с подтягиваниями во главе. Сначала вертикальные тяги, затем объём в горизонтальных."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以引体向上领衔的背部日。先做垂直拉，再堆水平拉的训练量。"
          }
        }
      }
    },
    "Purchase couldn't be verified. Try again or restore." : {
      "comment" : "Error message displayed when a subscription purchase can't be verified.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
