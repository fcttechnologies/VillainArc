        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가슴 고중량 위주. 힘이 남아 있을 때 프레스를 먼저 하고 보조 운동을 이어가요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
