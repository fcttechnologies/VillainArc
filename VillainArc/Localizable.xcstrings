          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5/3/1 de Wendler con volumen accesorio Boring But Big. Un levantamiento principal por día, luego 5x10 BBB al 50–70 % del máximo de entrenamiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5/3/1 de Wendler avec volume accessoire Boring But Big. Un mouvement principal par jour, puis 5x10 BBB à 50–70 % du max d'entraînement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il 5/3/1 di Wendler con il volume complementare Boring But Big. Un esercizio principale al giorno, poi 5x10 BBB al 50–70% del massimale di allenamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wendlerの5/3/1に、Boring But Bigの補助ボリュームを組み合わせます。1日1種目のメインリフトの後、トレーニングマックスの50〜70%で5x10のBBBを行います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "웬들러 5/3/1에 Boring But Big 보조 볼륨을 더했어요. 하루에 메인 종목 하나, 그다음 트레이닝 맥스의 50–70%로 BBB 5x10."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5/3/1 do Wendler com volume acessório Boring But Big. Um exercício principal por dia, depois 5x10 BBB a 50–70 % do máximo de treino."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5/3/1 Вендлера с подсобным объёмом Boring But Big. Одно основное движение в день, затем 5x10 BBB на 50–70% от тренировочного максимума."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
