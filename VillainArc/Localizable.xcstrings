        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande l'effort après la séance avant le récapitulatif lors de l'enregistrement de la séance."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pergunta o esforço pós-treino antes do resumo quando o treino está sendo salvo."
          }
