    "%@, you're burning %@ amount of energy a day as you did last year." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, du verbrennst pro Tag %2$@ Energie wie im letzten Jahr."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, you're burning %2$@ amount of energy a day as you did last year."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, estás quemando %2$@ energía al día que el año pasado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, tu brûles %2$@ d'énergie par jour que l'an dernier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, bruci %2$@ quantitativo di energia al giorno rispetto all'anno scorso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@、1日のエネルギー消費は昨年と%2$@です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, 하루 에너지 소모량이 작년과 %2$@ 수준이에요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, você está queimando %2$@ de energia por dia do que no ano passado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ты сжигаешь %2$@ энергии в день, что и в прошлом году."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@，你每天消耗的能量与去年%2$@。"
          }
        }
      }
    },
    "%@, you're burning %@ energy a day than you did last year." : {
