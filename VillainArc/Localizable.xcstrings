    "Cancel anytime in Settings. Subscription auto-renews until cancelled." : {
      "comment" : "A footer for the paywall that describes the terms of a subscription.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jederzeit in den Einstellungen kündbar. Das Abo verlängert sich automatisch, bis es gekündigt wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancela cuando quieras en Ajustes. La suscripción se renueva automáticamente hasta que se cancele."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annulez à tout moment dans les Réglages. L'abonnement se renouvelle automatiquement jusqu'à son annulation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi annullare quando vuoi nelle Impostazioni. L'abbonamento si rinnova automaticamente fino all'annullamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定からいつでもキャンセルできます。サブスクリプションはキャンセルするまで自動更新されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정에서 언제든 해지할 수 있어요. 해지 전까지 구독이 자동 갱신돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancele quando quiser em Ajustes. A assinatura é renovada automaticamente até ser cancelada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отменить можно в любой момент в Настройках. Подписка продлевается автоматически, пока её не отменить."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可随时在“设置”中取消。订阅在取消前会自动续订。"
          }
        }
      }
    },
