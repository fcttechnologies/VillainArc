    "Goals started today can only be deleted so they don’t immediately move into history.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Goals started today can only be deleted so they don’t immediately move into history."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heute gestartete Ziele können nur gelöscht werden, damit sie nicht sofort in den Verlauf wandern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los objetivos iniciados hoy solo se pueden eliminar para que no pasen de inmediato al historial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les objectifs commencés aujourd'hui peuvent uniquement être supprimés afin de ne pas passer immédiatement dans l'historique."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As metas iniciadas hoje só podem ser excluídas para que não passem imediatamente ao histórico."
