    "Connect Apple Health to capture live heart rate, energy, and Health workout records when your device supports it." : {
      "comment" : "A description of the benefits of connecting Apple Health.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinde Apple Health, um Live-Herzfrequenz, Energie und Health-Workout-Aufzeichnungen zu erfassen, wenn dein Gerät dies unterstützt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecta Apple Salud para capturar la frecuencia cardíaca en vivo, la energía y los registros de entrenamiento de Salud cuando tu dispositivo lo permita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connecte Apple Santé pour capturer la fréquence cardiaque en direct, l'énergie et les séances Santé lorsque ton appareil le permet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collega Apple Health per registrare frequenza cardiaca dal vivo, energia e allenamenti in Salute quando il dispositivo lo consente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Healthを連携すると、対応デバイスでリアルタイムの心拍数、エネルギー、Healthのワークアウト記録を取得できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Health를 연결하면 기기가 지원하는 경우 실시간 심박수, 에너지, 운동 기록을 함께 저장할 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecte o Apple Saúde para capturar frequência cardíaca ao vivo, energia e registros de treino da Saúde quando seu dispositivo permitir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подключите Apple Health, чтобы записывать пульс и энергию в реальном времени и сохранять тренировки в Здоровье, если устройство это поддерживает."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接 Apple Health，在设备支持时记录实时心率、能量消耗和健康训练记录。"
          }
        }
      }
    },
