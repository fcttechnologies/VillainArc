    "Background App Refresh is off, so hydration notifications may be delayed while the app is closed.": {
      "comment": "A description of the hydration notification delay.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hintergrundaktualisierung ist deaktiviert, daher können Flüssigkeits-Benachrichtigungen verzögert sein, während die App geschlossen ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La actualización en segundo plano está desactivada, por lo que las notificaciones de hidratación pueden retrasarse mientras la app está cerrada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'actualisation en arrière-plan est désactivée, les notifications d'hydratation peuvent donc être retardées lorsque l'app est fermée."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A atualização em segundo plano está desativada, então as notificações de hidratação podem atrasar enquanto o app está fechado."
          }
        }
      }
    },
