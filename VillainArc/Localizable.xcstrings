          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade una condición cuando una enfermedad, lesión, viaje, recuperación o descanso cambie cómo deberías entrenar."
          }
        },
        "fr" : {
          "stringUnit" : {
