    "You feel best when you sleep 7+ hours and keep average RPE at 8 or lower — %lld%% session-quality on those days." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du fühlst dich am besten, wenn du 7+ Stunden schläfst und die durchschnittliche RPE bei 8 oder darunter hältst — %lld%% Einheitsqualität an diesen Tagen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te sientes mejor cuando duermes 7+ horas y mantienes el RPE promedio en 8 o menos: %lld%% de calidad de sesión esos días."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous vous sentez au mieux quand vous dormez 7 h ou plus et maintenez un RPE moyen de 8 ou moins — %lld%% de qualité de séance ces jours-là."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você se sente melhor quando dorme mais de 7 horas e mantém o RPE médio em 8 ou menos — %lld%% de qualidade de sessão nesses dias."
          }
        }
      }
    },
