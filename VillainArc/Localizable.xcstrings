    "Day names, exercises, sets, and reps can use the format you already have. Import runs on-device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tagesnamen, Übungen, Sätze und Wiederholungen können das Format verwenden, das du bereits hast. Der Import läuft auf dem Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los nombres de los días, ejercicios, series y repeticiones pueden usar el formato que ya tienes. La importación se ejecuta en el dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les noms des jours, exercices, séries et répétitions peuvent utiliser le format que tu as déjà. L’import s’exécute sur l’appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nomi dei giorni, esercizi, serie e ripetizioni possono restare nel formato che usi già. L'importazione avviene sul dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "曜日名・種目・セット・レップは今の書式のままで大丈夫です。読み込みはデバイス上で行われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일차 이름, 종목, 세트, 횟수는 쓰던 형식 그대로 넣으면 돼요. 가져오기는 기기 안에서 처리돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
