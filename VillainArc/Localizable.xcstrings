    "Templates are a starting point. You can edit, add, or remove exercises after you pick one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vorlagen sind ein Ausgangspunkt. Du kannst Übungen bearbeiten, hinzufügen oder entfernen, nachdem du eine ausgewählt hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las plantillas son un punto de partida. Puedes editar, añadir o quitar ejercicios después de elegir una."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les modèles sont un point de départ. Vous pouvez modifier, ajouter ou supprimer des exercices après en avoir choisi un."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os modelos são um ponto de partida. Você pode editar, adicionar ou remover exercícios depois de escolher um."
          }
        }
      }
    },
    "Templates are just a starting point. You can adjust the split to fit your needs after you create it." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vorlagen sind nur ein Ausgangspunkt. Du kannst den Split nach dem Erstellen an deine Bedürfnisse anpassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Templates are just a starting point. You can adjust the split to fit your needs after you create it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las plantillas son solo un punto de partida. Puedes ajustar el split a tus necesidades después de crearlo."
          }
        },
        "fr" : {
